public/data/spans-osm-*.geojson
public/data/nodes-osm-*.geojson
public/data/nodes-peeringdb.geojson
public/data/nodes-landing-stations.geojson
public/data/spans-ofds-*.geojson
public/data/nodes-ofds-*.geojson

# Raw ETL cache (never committed)
data/raw/

# Seed-built + merged files are committed (small, reproducible offline)
# They can be regenerated with: ./scripts/run_etl.sh --offline

