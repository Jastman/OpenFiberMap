# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit real tokens.

# Optional: Cesium ion access token
# Get a free token at https://ion.cesium.com/tokens
# Without this, the app uses OSM imagery + flat terrain (still works great).
VITE_CESIUM_ION_TOKEN=

# Optional: Google Maps API key (for Google Maps base layer instead of OSM)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an API key and enable the "Map Tiles API"
# 3. Paste the key below — the app switches from OSM to Google Maps automatically.
# Without this, OSM is used (works fine, no cost).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: restrict allowed origins in production
# VITE_APP_URL=https://your-domain.com
