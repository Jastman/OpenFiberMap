{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfibermap.org/schema/v1/fiber-schema.json",
  "title": "OpenFiberMap GeoJSON Schema",
  "description": "GeoJSON schema for fiber optic network spans and nodes, aligned with the Open Fibre Data Standard (OFDS) v1.0. See https://open-fibre-data-standard.readthedocs.io/",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "name": {
      "type": "string",
      "description": "Dataset name, e.g. 'OpenFiberMap-Africa-v1'"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the dataset, e.g. '1.0.0'"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date of last dataset update"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier for the dataset as a whole, e.g. 'ODbL-1.0'"
    },
    "attribution": {
      "type": "string",
      "description": "Required attribution string for the dataset as a whole"
    },
    "crs": {
      "type": "object",
      "description": "Coordinate Reference System — default WGS84 (EPSG:4326)",
      "properties": {
        "type": { "type": "string", "const": "name" },
        "properties": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "default": "urn:ogc:def:crs:OGC:1.3:CRS84" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/FiberSpan" },
          { "$ref": "#/$defs/FiberNode" }
        ]
      }
    }
  },

  "$defs": {

    "FiberSpan": {
      "title": "FiberSpan",
      "description": "A physical fiber optic cable segment / corridor between two points.",
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "type": "string", "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["LineString", "MultiLineString"]
            },
            "coordinates": {
              "description": "GeoJSON coordinate array. For LineString: [[lon, lat], ...]. Elevation (m) optional as third element.",
              "type": "array"
            }
          }
        },
        "properties": {
          "type": "object",
          "required": [
            "ofm_layer",
            "span_id",
            "network_id",
            "operator",
            "status"
          ],
          "properties": {

            "ofm_layer": {
              "type": "string",
              "const": "fiber-spans",
              "description": "Always 'fiber-spans'. Used to split the FeatureCollection into typed layers."
            },

            "span_id": {
              "type": "string",
              "description": "Globally unique ID for this span within the dataset. Recommended format: '{network_id}--{sequential}', e.g. 'ng-mainone--001'"
            },

            "network_id": {
              "type": "string",
              "description": "ID of the parent network/operator dataset this span belongs to, e.g. 'ng-mainone', 'br-rnp'"
            },

            "name": {
              "type": ["string", "null"],
              "description": "Human-readable name of the span or route section, e.g. 'Lagos–Abuja Backbone Section 2'"
            },

            "operator": {
              "type": "string",
              "description": "Name of the network operator, e.g. 'MainOne', 'Liquid Intelligent Technologies', 'RNP'"
            },

            "operator_id": {
              "type": ["string", "null"],
              "description": "PeeringDB or OFDS operator identifier if available"
            },

            "country_iso": {
              "type": ["string", "null"],
              "description": "ISO 3166-1 alpha-2 country code of the primary country, e.g. 'NG'. Use 'XA' for cross-border spans."
            },

            "countries": {
              "type": ["array", "null"],
              "description": "All countries the span passes through, as ISO 3166-1 alpha-2 codes.",
              "items": { "type": "string", "minLength": 2, "maxLength": 2 }
            },

            "region": {
              "type": ["string", "null"],
              "description": "Geographic region. One of: africa, americas, europe, asia-pacific, middle-east, global",
              "enum": ["africa", "americas", "europe", "asia-pacific", "middle-east", "global", null]
            },

            "status": {
              "type": "string",
              "description": "Deployment status of this span.",
              "enum": [
                "deployed",
                "ready-for-service",
                "lit",
                "under-construction",
                "planned",
                "decommissioned",
                "unknown"
              ]
            },

            "burial_type": {
              "type": ["string", "null"],
              "description": "Physical installation method.",
              "enum": ["underground", "aerial", "subsea", "direct-buried", "conduit", "mixed", "unknown", null]
            },

            "length_km": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Approximate route length in kilometres. If null, compute from geometry."
            },

            "capacity_gbps": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Total design capacity in Gbps. Use null if unknown."
            },

            "capacity_class": {
              "type": ["string", "null"],
              "description": "Derived capacity tier for visualization. Computed by ETL from capacity_gbps.",
              "enum": ["ultra-high", "high", "medium", "low", "unknown", null]
            },

            "fiber_pairs": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "Number of fiber pairs (strands) in the cable, if known."
            },

            "fiber_type": {
              "type": ["string", "null"],
              "description": "Fiber standard, e.g. 'G.652D', 'G.654E', 'G.655'",
              "examples": ["G.652D", "G.654E", "G.655", "G.657A1"]
            },

            "phase_id": {
              "type": ["string", "null"],
              "description": "OFDS PhaseCollection ID — links to construction phase/contract batch"
            },

            "phase_name": {
              "type": ["string", "null"],
              "description": "Human-readable phase name, e.g. 'Phase 1 — Lagos to Abuja'"
            },

            "construction_start": {
              "type": ["string", "null"],
              "format": "date",
              "description": "Planned or actual construction start date (ISO 8601)"
            },

            "ready_for_service": {
              "type": ["string", "null"],
              "format": "date",
              "description": "Planned or actual ready-for-service date (ISO 8601)"
            },

            "funders": {
              "type": ["array", "null"],
              "description": "Organizations that funded construction, e.g. ['World Bank', 'IFC']",
              "items": { "type": "string" }
            },

            "contracts": {
              "type": ["array", "null"],
              "description": "Contract or tender reference numbers.",
              "items": { "type": "string" }
            },

            "source": {
              "type": "string",
              "description": "Short name of the primary data source, e.g. 'OFDS-datasets', 'AfTerFibre', 'OSM', 'PeeringDB'"
            },

            "source_url": {
              "type": ["string", "null"],
              "format": "uri",
              "description": "Direct URL to the source dataset or record"
            },

            "license": {
              "type": ["string", "null"],
              "description": "SPDX license identifier of the source data, e.g. 'CC-BY-4.0', 'ODbL-1.0'"
            },

            "attribution": {
              "type": ["string", "null"],
              "description": "Required attribution string from the source"
            },

            "last_updated": {
              "type": ["string", "null"],
              "format": "date",
              "description": "ISO 8601 date when this record was last verified/updated"
            },

            "notes": {
              "type": ["string", "null"],
              "description": "Free-text notes, data caveats, or editorial commentary"
            },

            "ofds_span_id": {
              "type": ["string", "null"],
              "description": "Original OFDS span ID from the source dataset, if available"
            },

            "osm_way_id": {
              "type": ["string", "null"],
              "description": "OpenStreetMap Way ID if geometry is derived from OSM"
            }
          },
          "additionalProperties": true
        }
      }
    },

    "FiberNode": {
      "title": "FiberNode",
      "description": "A network node: POP, IXP, data center, submarine cable landing station, amplifier, or exchange.",
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "type": "string", "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "type": "string", "const": "Point" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "description": "[longitude, latitude] or [longitude, latitude, elevation_m]",
              "items": { "type": "number" }
            }
          }
        },
        "properties": {
          "type": "object",
          "required": [
            "ofm_layer",
            "node_id",
            "network_id",
            "operator",
            "node_type",
            "status"
          ],
          "properties": {

            "ofm_layer": {
              "type": "string",
              "const": "fiber-nodes",
              "description": "Always 'fiber-nodes'."
            },

            "node_id": {
              "type": "string",
              "description": "Globally unique ID, e.g. 'ixp-ng-lagos-01' or 'peeringdb-fac-1234'"
            },

            "network_id": {
              "type": "string",
              "description": "Parent network/operator ID, same namespace as FiberSpan.network_id"
            },

            "name": {
              "type": "string",
              "description": "Node name, e.g. 'Lagos Internet Exchange (LINX)', 'Teraco JB1'"
            },

            "name_short": {
              "type": ["string", "null"],
              "description": "Short/abbreviated name for map labels, e.g. 'LINX'"
            },

            "operator": {
              "type": "string",
              "description": "Operating organization name"
            },

            "node_type": {
              "type": "string",
              "description": "Functional type of the node.",
              "enum": [
                "ixp",
                "data-center",
                "pop",
                "landing-station",
                "amplifier",
                "exchange",
                "telecom-hotel",
                "government-node",
                "research-node",
                "unknown"
              ]
            },

            "status": {
              "type": "string",
              "enum": [
                "operational",
                "planned",
                "under-construction",
                "decommissioned",
                "unknown"
              ]
            },

            "city": {
              "type": ["string", "null"],
              "description": "City where the node is located"
            },

            "country_iso": {
              "type": ["string", "null"],
              "description": "ISO 3166-1 alpha-2 country code"
            },

            "region": {
              "type": ["string", "null"],
              "enum": ["africa", "americas", "europe", "asia-pacific", "middle-east", "global", null]
            },

            "address": {
              "type": ["string", "null"],
              "description": "Physical street address (if publicly available)"
            },

            "floor_space_sqm": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Data center floor space in square metres"
            },

            "power_mw": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Total installed power in megawatts (data centers)"
            },

            "connected_networks": {
              "type": ["array", "null"],
              "description": "ASNs or network_ids of networks present at this node",
              "items": { "type": "string" }
            },

            "peeringdb_id": {
              "type": ["integer", "null"],
              "description": "PeeringDB facility or IXP numeric ID"
            },

            "peeringdb_ix_id": {
              "type": ["integer", "null"],
              "description": "PeeringDB IX (internet exchange) numeric ID"
            },

            "website": {
              "type": ["string", "null"],
              "format": "uri"
            },

            "source": {
              "type": "string"
            },

            "source_url": {
              "type": ["string", "null"],
              "format": "uri"
            },

            "license": {
              "type": ["string", "null"]
            },

            "attribution": {
              "type": ["string", "null"]
            },

            "last_updated": {
              "type": ["string", "null"],
              "format": "date"
            },

            "notes": {
              "type": ["string", "null"]
            },

            "osm_node_id": {
              "type": ["string", "null"],
              "description": "OpenStreetMap Node ID if derived from OSM"
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
